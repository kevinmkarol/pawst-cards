# ABOUTME: Example of petcam.env, the one file that names your own machines and where photos go.
# ABOUTME: Copy it to petcam.env (ignored by git) and fill in the values; scripts source it.

# SSH target of the camera, for the deploy scripts. recamera.local is its factory mDNS name and
# works on the same network; for a camera on another network use its tailnet address here too.
PETCAM_CAMERA_HOST=recamera@recamera.local

# Where the collector reaches the camera agent's API. On the same network,
# http://recamera.local:8765; across networks, the camera's tailnet address or MagicDNS name.
PETCAM_CAMERA_AGENT_URL=http://recamera.local:8765

# For collector/macos/deploy.sh: SSH target of the always-on Mac that runs the collector, and
# its home directory there. Not needed with deploy.sh --local, or when the collector runs some
# other way.
PETCAM_COLLECTOR_HOST=you@collector.example
PETCAM_COLLECTOR_HOME=/Users/you

# User name and password of the camera's video stream (RTSP, port 554). It leaves the factory as
# admin and admin; set a password of your own here and camera/pipeline/install.sh gives it to
# the camera, which uses it from its next start. The selector page and the live view read the
# same two values. Letters, digits and . _ ~ - only. Leave unset to keep the factory's.
# PETCAM_RTSP_USER=admin
# PETCAM_RTSP_PASSWORD=

# Flags for the agent on the camera, on one line; camera/agent/install_service.sh puts them
# in place. --home is where the camera rests and --patrol the stops it sweeps when idle, each
# as yaw,pitch in degrees. `python3 -m petcam.agent --help` lists the rest. Leave empty for the
# built-in ones, which know nothing about your room.
PETCAM_AGENT_ARGS="--home 180,100 --patrol 90,100 135,100 225,100 270,100"

# From here to PETCAM_KEEP_VISITS_DAYS the values are where the collector starts. Except for the
# command and its stage directory, the Settings tab of the selector page changes them while
# the collector runs, and what is saved there wins over what is written here.

# Time zone where the pets live; used for captions and photo names (and, with the macOS
# install, the collector log). Empty means UTC.
PETCAM_TIMEZONE=America/New_York

# The animals the camera follows and the photo picker looks for, separated by spaces. The
# camera's model knows these: bird cat dog horse sheep cow elephant bear zebra giraffe. Other
# pets (rabbits, hamsters, reptiles) are not seen at all. Leave unset for cat dog. The Settings
# tab of the selector page changes it later.
# PETCAM_PETS="cat dog"

# What the pet is called in captions ("Biscuit visit Sun 6:25 AM") and photo names
# (biscuit_...jpg). Leave unset for "pet".
# PETCAM_SUBJECT=Biscuit

# How each visit's photo leaves the house: "command" or "webhook".
PETCAM_DELIVER=command

# command: run once per delivery. {photo}, {caption} and {visit_dir} each become one argument;
# write any other brace as {{ or }}. No shell is involved, so quoting works as in a shell but
# pipes and variables do not. Give the program's full path if it is installed anywhere but
# Homebrew, /usr/local/bin or ~/.local/bin: a background service does not have your shell's PATH.
# This example posts to Slack through the OpenClaw CLI, which only reads files from its own
# directories, hence PETCAM_STAGE_DIR. Leave PETCAM_STAGE_DIR empty for tools without that rule.
# Staged copies older than a week are removed.
PETCAM_DELIVER_COMMAND="openclaw message send --channel slack --target channel:C0XXXXXXXXX --media {photo} -m {caption}"
PETCAM_STAGE_DIR=/Users/you/.openclaw/media/petcam

# webhook: POST multipart form data (fields caption, visit, photo; clip files too when
# PETCAM_DELIVER_CLIPS=true) to this URL.
PETCAM_DELIVER_URL=https://hooks.example/pawst
PETCAM_DELIVER_CLIPS=false

# Deliver at most once in this many minutes. Visits collected in between wait and go out
# together as one delivery: their photos side by side in one picture, their captions as lines
# of one caption. Leave empty to deliver every visit as soon as it is collected.
PETCAM_DELIVER_EVERY_MINUTES=

# The collector archives every visit under ~/petcam/visits: clips, candidate frames, the chosen
# photo and visit.json, roughly 100 MB a visit. Set this to delete each archived visit that
# many days after it was collected. Leave empty, or 0, to keep the archive for ever.
PETCAM_KEEP_VISITS_DAYS=

# Where the optional photo selector keeps its ratings and models, and the collector the map of
# the camera's views. Leave unset for ~/petcam/selector.
# PETCAM_SELECTOR_DIR=

# For collector/macos/deploy.sh: set an address and the selector page (ratings, settings, aiming)
# is installed beside the collector and kept running. 127.0.0.1 serves that Mac alone; an
# address of that Mac, such as its tailnet one, serves your other devices. Leave unset to start
# the page by hand with ./pawst-selector annotate. The first install downloads about 2.5 GB.
# PETCAM_PAGE_HOST=127.0.0.1
# PETCAM_PAGE_PORT=8798

# Passphrase the selector page asks for before it changes anything, when this is in the page's
# environment. Leave unset for a page only you can reach.
# PETCAM_PAGE_PASSPHRASE=

# The camera's video stream, for the picture the page shows while you aim. Leave unset for
# the reCamera's stock stream on the agent's host, port 554, with the user name and password
# above.
# PETCAM_CAMERA_STREAM_URL=

# Camera address reachable from your development machine, for the agent's MQTT broker tests.
# Leave unset to skip those tests.
# PETCAM_BROKER=100.64.0.2
